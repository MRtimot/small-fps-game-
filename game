const BROADCAST={queue:[],current:null,currentTimer:null,nextDataAt:performance.now()+2500,dataInterval:4000};
function broadcast(text,priority=0){
BROADCAST.queue.push({text,priority,time:performance.now()});
BROADCAST.queue.sort((a,b)=>b.priority-a.priority||a.time-b.time);
if(!BROADCAST.current) showNextBroadcast();
}
function showNextBroadcast(){
if(BROADCAST.queue.length===0){BROADCAST.current=null;return;}
const item=BROADCAST.queue.shift();
BROADCAST.current=item;
const el=document.getElementById('broadcast');
el.textContent=item.text;el.classList.add('on');
const dur=item.priority>=2?3800:item.priority>=1?2400:2000;
if(BROADCAST.currentTimer) clearTimeout(BROADCAST.currentTimer);
BROADCAST.currentTimer=setTimeout(()=>{el.classList.remove('on');setTimeout(()=>{BROADCAST.current=null;showNextBroadcast();},320);},dur);
}
