gunSpring.vel.z+=(-k*gunSpring.pos.z-dmp*gunSpring.vel.z)*dt;
gunSpring.pos.z+=gunSpring.vel.z*dt;
gunSpring.rotVel.x+=(-k*gunSpring.rot.x-dmp*gunSpring.rotVel.x)*dt;
gunSpring.rot.x+=gunSpring.rotVel.x*dt;
swayTime+=dt*(player.moving?10:2);
const bob=player.moving?0.015:0.004;
gunHolder.position.x=Math.sin(swayTime)*bob;
gunHolder.position.y=Math.sin(swayTime*2)*bob*0.5;
gunHolder.position.z=gunSpring.pos.z*0.05;
gunHolder.rotation.x=gunSpring.rot.x*0.1;
gunHolder.rotation.z=-camera.rotation.y*0.05;
if(mouseDown&&WEAPONS[currentWeapon].isAuto) tryShoot();
updateBots(dt);
}

dirLight.position.set(camera.position.x+15,25,camera.position.z+10);
dirLight.target.position.set(camera.position.x,0,camera.position.z);
dirLight.target.updateMatrixWorld();

updateProjectiles(dt);
updateParticles(dt);
updateDecals(dt);

if(shake.intensity>0.001){
const s=shake.intensity;
shakeOff.x=(Math.random()-0.5)*s;
shakeOff.y=(Math.random()-0.5)*s;
camera.position.x+=shakeOff.x; camera.position.y+=shakeOff.y;
shake.intensity*=Math.pow(0.001,dt);
}

if(ENABLE_PERF_LOG&&frameCount%120===0){
const info=renderer.info.render;
console.log(`[Perf] Draws: ${info.calls} | Tris: ${info.triangles}`);
}

composer.render();
}

animate();
updateHUD();updateXK9Panel();

setTimeout(()=>{
broadcast('固件 3.4.7-BLACKLIST 已加载。',0);
log('[ARBITER-9] BOOT COMPLETE','dim');
},8500);
setTimeout(()=>broadcast('传感器阵列在线。',0),9700);
setTimeout(()=>broadcast('云端链路已建立。',0),10900);
setTimeout(()=>broadcast('等待击发。',0),12300);

const startEl=document.getElementById('start');
document.body.addEventListener('click',()=>{
if(!bootDone||wonGame) return;
getAudio();
if(!controls.isLocked&&!dossierOpen){
controls.lock();
startEl.style.display='none';
}
});
controls.addEventListener('unlock',()=>{
if(!dossierOpen&&!wonGame) startEl.style.display='block';
mouseDown=false;
});
document.addEventListener('pointerlockchange',()=>{
if(controls.isLocked) startEl.style.display='none';
});

window.addEventListener('resize',()=>{
camera.aspect=innerWidth/innerHeight;camera.updateProjectionMatrix();
renderer.setSize(innerWidth,innerHeight);
composer.setSize(innerWidth,innerHeight);
if(ssaoPass) ssaoPass.setSize(innerWidth,innerHeight);
const p=renderer.getPixelRatio();
fxaa.material.uniforms['resolution'].value.x=1/(innerWidth*p);
fxaa.material.uniforms['resolution'].value.y=1/(innerHeight*p);
});
</script>
</body>
</html>
