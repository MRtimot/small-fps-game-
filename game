const AI_STATE={PATROL:'PATROL',COMBAT:'COMBAT',SEARCH:'SEARCH'};
function losClear(from,to){
const dir=new THREE.Vector3().subVectors(to,from);const dist=dir.length();
if(dist<0.1) return true;dir.normalize();
return new THREE.Raycaster(from,dir,0.2,dist-0.2).intersectObjects(worldObjects,false).length===0;
}
const coverPoints=[new THREE.Vector3(7,0,6),new THREE.Vector3(-7,0,-6),new THREE.Vector3(-10,0,9),new THREE.Vector3(9,0,-9),new THREE.Vector3(5,0,12),new THREE.Vector3(-5,0,-12)];
function findCover(bp,pp){
let best=null,bs=-Infinity;
for(const cp of coverPoints){
const eye=cp.clone();eye.y=1.2;
if(losClear(eye,pp.clone().setY(1.6))) continue;
const s=20-bp.distanceTo(cp);if(s>bs){bs=s;best=cp;}
}
return best;
}
