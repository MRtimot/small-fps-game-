function updateBotInjury(bot,dt){
const u=bot.userData;
if(u.isDead) return;
const newLevel=u.health<=0?3:u.health<35?2:u.health<70?1:0;
u.injuryLevel=newLevel;
u.breathTimer-=dt;
if(u.breathTimer<=0&&u.injuryLevel>=1&&u.injuryLevel<=2){
const interval=u.injuryLevel===2?1.8:2.8;
u.breathTimer=interval+Math.random()*0.8;
playBreath(u.injuryLevel, bot.position.clone());
}
if(u.injuryLevel===2&&Math.random()<0.004) playCurse(bot.position.clone());
if(u.injuryLevel>=1&&u.injuryLevel<=2){
const amt=u.injuryLevel*0.006;
bot.position.x+=(Math.random()-0.5)*amt;
bot.position.z+=(Math.random()-0.5)*amt;
}
const targetBodyScale=[1,0.9,0.65,0.5][u.injuryLevel];
u.body.scale.y=THREE.MathUtils.lerp(u.body.scale.y,targetBodyScale,dt*2);
const targetHeadY=u.injuryLevel>=2?0.9:u.injuryLevel>=1?1.6:1.8;
u.head.position.y=THREE.MathUtils.lerp(u.head.position.y,targetHeadY,dt*2);
if(u.face) u.face.position.y=u.head.position.y;
const sY=u.body.scale.y;
if(u.armL) u.armL.position.y=0.3+0.8*sY;
if(u.armR) u.armR.position.y=0.3+0.8*sY;
if(u.botGun) u.botGun.position.y=0.35+0.8*sY;
if(u.injuryLevel>=2&&!u.dropGun&&Math.random()<0.008){
u.dropGun=true;
log('[BOT] WEAPON DROPPED — INCAPACITATED','dim');
}
}

function updateBots(dt){
const pp=camera.position,now=performance.now();
for(const bot of bots){
if(bot.userData.isDead) continue;
if(bot.userData.isDying){updateDying(bot,dt);continue;}
updateBotInjury(bot,dt);
const spdMul=[1,0.65,0.35,0][bot.userData.injuryLevel]||1;
const be=bot.position.clone();be.y=bot.userData.injuryLevel>=2?0.8:1.6;
const dist=new THREE.Vector3().subVectors(pp,be).length();
const canSee=dist<40&&losClear(be,pp);
bot.userData.canSeePlayer=canSee;
if(canSee){
bot.userData.lastSeen=pp.clone();
if(bot.userData.state!==AI_STATE.COMBAT){
bot.userData.state=AI_STATE.COMBAT;
bot.userData.stateTimer=0;
}
}
bot.userData.stateTimer+=dt;
if(bot.userData.state===AI_STATE.PATROL){
if(!bot.userData.patrolTarget||bot.position.distanceTo(bot.userData.patrolTarget)<1.5)
bot.userData.patrolTarget=new THREE.Vector3((Math.random()-0.5)*44,0,(Math.random()-0.5)*44);
const d=new THREE.Vector3().subVectors(bot.userData.patrolTarget,bot.position);d.y=0;
if(d.length()>0.1){d.normalize();bot.position.addScaledVector(d,bot.userData.speed*spdMul*0.6*dt);}
bot.rotation.y+=Math.sin(now*0.001+bot.position.x)*0.01;
}else if(bot.userData.state===AI_STATE.COMBAT){
bot.lookAt(pp.x,bot.position.y,pp.z);
if(bot.userData.health<40&&!bot.userData.coverTarget){
const cp=findCover(bot.position,pp);
if(cp){bot.userData.coverTarget=cp;bot.userData.state=AI_STATE.SEARCH;bot.userData.stateTimer=0;continue;}
}
const toP=new THREE.Vector3().subVectors(pp,bot.position);toP.y=0;toP.normalize();
const right=new THREE.Vector3(-toP.z,0,toP.x);
const mv=new THREE.Vector3();
if(!canSee){
mv.addScaledVector(right,bot.userData.strafeDir*1.2);
if(Math.random()<0.008) bot.userData.strafeDir*=-1;
}else{
if(dist>12) mv.add(toP);
else if(dist<6) mv.sub(toP);
else mv.addScaledVector(right,bot.userData.strafeDir*0.6);
}
const probeDir=mv.clone().normalize();
const probeFrom=bot.position.clone(); probeFrom.y=1;
const probeRay=new THREE.Raycaster(probeFrom,probeDir,0,1.5);
if(probeRay.intersectObjects(worldObjects,false).length>0){
const side=new THREE.Vector3(-probeDir.z,0,probeDir.x);
